{
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-fable.sh"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__merge_pull_request|mcp__github__push_files|mcp__github__create_or_update_file",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/deploy-guard.sh"
          }
        ]
      }
    ]
  }
}
